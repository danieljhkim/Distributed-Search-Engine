            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.vscode/.env.local",
            "env": {
                "DS_NODE_ROLE": "indexnode",
                "DS_ENV": "local",
                "SHARD_ID": "shard-2",
                "INDEX_NODE_PORT": "9310",
                "INDEX_NODE_HEALTH_PORT": "9311",
                "DS_CONFIG_PATH": "${workspaceFolder}/config/app-config.yaml",
                "INDEX_NODE_BASE_DIR": "${workspaceFolder}/.local/data/shard-2",
