                "-Duser.timezone=UTC",
                "-Dlog.dir=${env:DS_LOG_DIR}",
                "-XX:+UseG1GC",
                "-XX:MaxGCPauseMillis=200",
                "-Xms512m",
                "-Xmx1024m",
                "-Dcom.sun.management.jmxremote",
                "-Dcom.sun.management.jmxremote.local.only=false",
                "-Dcom.sun.management.jmxremote.port=19310",
                "-Dcom.sun.management.jmxremote.rmi.port=19310",
                "-Dcom.sun.management.jmxremote.authenticate=false",
                "-Dcom.sun.management.jmxremote.ssl=false"
            ]
        },
        {
            "name": "dsearch: IndexNode (attach :5008)",
            "type": "java",
            "request": "attach",
            "hostName": "127.0.0.1",
            "port": 5008
        }
    ],
    "compounds": [
        {
            "name": "dsearch: Cluster (1 shard)",
            "configurations": [
                "dsearch: Coordinator (launch)",
                "dsearch: IndexNode (shard-1, launch)",
                "dsearch: QueryNode (launch)",
                "dsearch: Gateway (launch)"
            ],
            "stopAll": true
        },
        {
            "name": "dsearch: Cluster (2 shards)",
            "configurations": [
                "dsearch: Coordinator (launch)",
                "dsearch: IndexNode (shard-1, launch)",
                "dsearch: IndexNode (shard-2, launch)",
                "dsearch: QueryNode (launch)",
                "dsearch: Gateway (launch)"
            ],
            "stopAll": true
        },
        {
            "name": "dsearch: Attach All (local ports)",
            "configurations": [
                "dsearch: Coordinator (attach :5005)",
                "dsearch: Gateway (attach :5006)",
                "dsearch: QueryNode (attach :5007)",
                "dsearch: IndexNode (attach :5008)"
            ],
            "stopAll": true
        }
    ]
}