{
    "version": "0.2.0",
    "configurations": [
        /* ----------------------------- Shared Notes -----------------------------
       * - Replace projectName and mainClass with your actual module + main.
       * - Keep config paths stable (e.g., ./config/app-config.yaml).
       * - Prefer envFile for secrets and local-only overrides.
       * --------------------------------------------------------------------- */
        /* ============================ COORDINATOR ============================ */
        {
            "name": "dsearch: Coordinator (launch)",
            "type": "java",
            "request": "launch",
            "projectName": "dk.coordinator",
            "mainClass": "com.danieljhkim.dsearch.coordinator.CoordinatorApplication",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.vscode/.env.local",
            "env": {
                "DS_NODE_ROLE": "coordinator",
                "DS_ENV": "local",
                "COORDINATOR_PORT": "9000",
                "COORDINATOR_HEALTH_PORT": "9001",
                "DS_CONFIG_PATH": "${workspaceFolder}/config/app-config.yaml",
                "DS_LOG_DIR": "${workspaceFolder}/.local/logs/coordinator"
            },
            "args": [
                "--config=${env:DS_CONFIG_PATH}"
            ],
            "vmArgs": [
                "-Dfile.encoding=UTF-8",
                "-Duser.timezone=UTC",
                "-Dlog.dir=${env:DS_LOG_DIR}",
                "-XX:+UseG1GC",
                "-XX:MaxGCPauseMillis=200",
                "-Xms256m",
                "-Xmx512m",
                "-Dcom.sun.management.jmxremote",
                "-Dcom.sun.management.jmxremote.local.only=false",
                "-Dcom.sun.management.jmxremote.port=19000",
                "-Dcom.sun.management.jmxremote.rmi.port=19000",
                "-Dcom.sun.management.jmxremote.authenticate=false",
                "-Dcom.sun.management.jmxremote.ssl=false"
            ]
        },
        {
            "name": "dsearch: Coordinator (attach :5005)",
            "type": "java",
            "request": "attach",
            "hostName": "127.0.0.1",
            "port": 5005
        },
        /* ============================== GATEWAY ============================== */
        {
            "name": "dsearch: Gateway (launch)",
            "type": "java",
