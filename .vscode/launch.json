            "env": {
                "DS_NODE_ROLE": "gateway",
                "DS_ENV": "local",
                "GATEWAY_PORT": "8080",
                "GATEWAY_HEALTH_PORT": "8081",
                "DS_CONFIG_PATH": "${workspaceFolder}/config/app-config.yaml",
                "DS_LOG_DIR": "${workspaceFolder}/.local/logs/gateway"
            },
            "args": [
                "--config=${env:DS_CONFIG_PATH}"
            ],
            "vmArgs": [
                "-Dfile.encoding=UTF-8",
                "-Duser.timezone=UTC",
                "-Dlog.dir=${env:DS_LOG_DIR}",
                "-XX:+UseG1GC",
                "-XX:MaxGCPauseMillis=200",
                "-Xms256m",
                "-Xmx512m",
                "-Dcom.sun.management.jmxremote",
                "-Dcom.sun.management.jmxremote.local.only=false",
                "-Dcom.sun.management.jmxremote.port=18080",
                "-Dcom.sun.management.jmxremote.rmi.port=18080",
                "-Dcom.sun.management.jmxremote.authenticate=false",
                "-Dcom.sun.management.jmxremote.ssl=false"
            ]
        },
        {
            "name": "dsearch: Gateway (attach :5006)",
            "type": "java",
            "request": "attach",
            "hostName": "127.0.0.1",
            "port": 5006
        },
        /* ============================== QUERY NODE =========================== */
