{
  "servers": {
    "devbox": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/.box/mcp/server/dist/devbox-mcp.mjs"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production"
      }
    },
      "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_mcp_pat}"
      }
    }
  },
    "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ]
}
