{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danieljhkim.com/dsearch/schemas/search_request.schema.json",
  "title": "SearchRequest",
  "description": "Canonical schema for a search request submitted to the dsearch Gateway.",
  "type": "object",
  "additionalProperties": false,

  "required": ["query"],

  "properties": {
    "query": {
      "type": "string",
      "description": "Query text. For semantic or hybrid modes, this text may be embedded.",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "description": "Search execution mode.",
      "enum": ["LEXICAL", "SEMANTIC", "HYBRID"],
      "default": "LEXICAL"
    },
    "from": {
      "type": "integer",
      "description": "Zero-based result offset.",
      "minimum": 0,
      "default": 0
    },
    "size": {
      "type": "integer",
      "description": "Maximum number of results to return.",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "shardId": {
      "type": "string",
      "description": "Optional shard routing hint. If omitted, routing is determined by the gateway."
    },
    "weights": {
      "type": "object",
      "description": "Optional weighting configuration for HYBRID search mode.",
      "additionalProperties": false,
      "properties": {
        "lexical": {
          "type": "number",
          "description": "Weight for lexical scoring.",
          "minimum": 0,
          "maximum": 1
        },
        "semantic": {
          "type": "number",
          "description": "Weight for semantic scoring.",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "filters": {
      "type": "object",
      "description": "Optional low-cardinality filters applied during search.",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
