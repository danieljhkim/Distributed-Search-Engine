# ================================
# DevBox local runtime configuration
# Repo: dsearch
# This file is machine-local. Do not commit.
# ================================

# --------------------------------
# Runtime lifecycle
# --------------------------------

# Start the local multi-node cluster
BOX_UP_CMD="./scripts/run_cluster_multi.sh start"

# Stop all local cluster processes
BOX_DOWN_CMD="./scripts/run_cluster_multi.sh stop"

BOX_TEST_CMD="./scripts/test_search.sh"

# --------------------------------
# Health / readiness
# --------------------------------

# Gateway health endpoint (Spring Boot actuator)
BOX_HEALTH_URL="http://localhost:8080/actuator/health"

# Retry behavior (gateway + cluster startup can take time)
BOX_HEALTH_RETRIES=30
BOX_HEALTH_SLEEP_SECS=2

# --------------------------------
# Logs / observation
# --------------------------------

# Directory DevBox tools should treat as logs
BOX_LOG_DIR="logs"

# Max bytes agents may read per log request
BOX_MAX_LOG_BYTES=2000000


# --------------------------------
# Optional: ports (used by doctor checks)
# --------------------------------

BOX_EXPECTED_PORTS="8080,7000,5000,5001,6000,6001"

# --------------------------------
# Safety
# --------------------------------

# Explicitly declare this is a local-only environment
BOX_ENVIRONMENT="local"