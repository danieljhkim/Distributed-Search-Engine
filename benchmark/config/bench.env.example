# Common benchmark env for dsearch

# Gateway HTTP
DSEARCH_GATEWAY_BASE_URL=http://localhost:8080
DSEARCH_GATEWAY_SEARCH_PATH=/api/v1/search

# QueryNode gRPC
DSEARCH_QUERYNODE_ADDR=localhost:6000

# Benchmark defaults
DSEARCH_BENCH_VUS=5
DSEARCH_BENCH_DURATION=15s
DSEARCH_BENCH_QUERY="hola hello world"
DSEARCH_BENCH_PAGE=0
DSEARCH_BENCH_PAGE_SIZE=30
DSEARCH_BENCH_SEARCH_TYPE=HYBRID