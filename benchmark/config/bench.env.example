# Public API benchmark defaults. Do not commit machine-specific values.
DSEARCH_GATEWAY_BASE_URL=http://localhost:8080
DSEARCH_GATEWAY_SEARCH_PATH=/api/v1/search
DSEARCH_GATEWAY_INDEX_PATH=/api/v1/index
DSEARCH_BENCH_PROFILE=ci-smoke
DSEARCH_BENCH_DATASET=./datasets/ci-smoke.jsonl
DSEARCH_BENCH_QUERY_MIX=../config/query-mixes.json
DSEARCH_BENCH_VUS=2
DSEARCH_BENCH_DURATION=10s
DSEARCH_BENCH_WARMUP=5s
DSEARCH_BENCH_PAGE_SIZE=10
DSEARCH_BENCH_PARTITION_ID=bench
DSEARCH_BENCH_EXPECTED_FANOUT=1
DSEARCH_BENCH_REFRESH_QUERY=refresh commit cost
DSEARCH_BENCH_REFRESH_EXPECTED_ID=bench-refresh-01
DSEARCH_BENCH_REFRESH_TIMEOUT_SECONDS=30
DSEARCH_IMAGE_DIGESTS=unknown
DSEARCH_EMBEDDING_MODEL=unknown
DSEARCH_RUN_LABEL=local
DSEARCH_DATASET_DOCUMENTS=100000
DSEARCH_GENERATED_DATASET=./datasets/generated/capacity.jsonl
DSEARCH_BENCH_CAPACITY_WARMUP=60s
DSEARCH_BENCH_CAPACITY_DURATION=300s
